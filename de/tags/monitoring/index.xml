&lt;td&gt;MQTT/InfluxDB&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;strong&gt;System-Betriebszeit&lt;/strong&gt;&lt;/td&gt;
&lt;td&gt;Controller-Betriebszeit und Verbindungsstatus&lt;/td&gt;
&lt;td&gt;MQTT/InfluxDB&lt;/td&gt;
