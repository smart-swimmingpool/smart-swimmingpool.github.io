&lt;h4&gt;&lt;strong&gt;🔹 Wichtige Hinweise zur Niedervolt-Verdrahtung&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-wichtige-hinweise-zur-niedervolt-verdrahtung"&gt;&lt;/span&gt;
&lt;a href="#-wichtige-hinweise-zur-niedervolt-verdrahtung" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h4&gt;&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;DS18B20:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;VDD&lt;/strong&gt; → &lt;strong&gt;3.3V&lt;/strong&gt; (nicht 5V!).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;GND&lt;/strong&gt; → &lt;strong&gt;GND&lt;/strong&gt; (gemeinsam mit ESP32).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;DATA&lt;/strong&gt; → &lt;strong&gt;GPIO32/33&lt;/strong&gt; + &lt;strong&gt;4.7kΩ Pull-Up zu 3.3V&lt;/strong&gt;.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Relay-Modul:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;VCC&lt;/strong&gt; → &lt;strong&gt;5V&lt;/strong&gt; (vom ESP32 VIN oder externem Netzteil).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;GND&lt;/strong&gt; → &lt;strong&gt;GND&lt;/strong&gt; (gemeinsam mit ESP32).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;IN1/IN2&lt;/strong&gt; → &lt;strong&gt;GPIO25/26&lt;/strong&gt; (Aktiv-High!).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Stromversorgung:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;USB-Netzteil:&lt;/strong&gt; Mindestens &lt;strong&gt;5V/1A&lt;/strong&gt; (für ESP32 + 1 Relay).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Für 2 Relays:&lt;/strong&gt; Mindestens &lt;strong&gt;5V/2A&lt;/strong&gt; (z. B. USB-Netzteil eines Tablets).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;hr&gt;
&lt;h2&gt;🔥 &lt;strong&gt;Brandschutz &amp;amp; Überhitzung&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-brandschutz--überhitzung"&gt;&lt;/span&gt;
&lt;a href="#-brandschutz--%c3%bcberhitzung" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h2&gt;&lt;h3&gt;&lt;strong&gt;🔹 Überhitzung vermeiden&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-überhitzung-vermeiden"&gt;&lt;/span&gt;
&lt;a href="#-%c3%bcberhitzung-vermeiden" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Relay-Modul:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Relays können heiß werden&lt;/strong&gt; (besonders bei hoher Last).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Lösung:&lt;/strong&gt;
&lt;ul&gt;
&lt;li&gt;Verwenden Sie ein &lt;strong&gt;Relay-Modul mit Optokoppler und Kühlkörper&lt;/strong&gt;.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Belüftung&lt;/strong&gt; im Gehäuse sicherstellen.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;ESP32:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;ESP32 wird normalerweise nicht heiß&lt;/strong&gt;, aber bei hoher Last (z. B. viele Sensoren) kann er warm werden.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Lösung:&lt;/strong&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Gehäuse mit Lüftungsschlitzen&lt;/strong&gt; verwenden.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Nicht in der direkten Sonne&lt;/strong&gt; platzieren.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Netzteil:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Billige Netzteile können überhitzen&lt;/strong&gt;.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Lösung:&lt;/strong&gt;
&lt;ul&gt;
&lt;li&gt;Verwenden Sie ein &lt;strong&gt;qualitativ hochwertiges Netzteil&lt;/strong&gt; (z. B. von Mean Well).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Mindestens 5V/2A&lt;/strong&gt; für ESP32 + 2 Relays.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;&lt;strong&gt;🔹 Brandschutzmaßnahmen&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-brandschutzmaßnahmen"&gt;&lt;/span&gt;
&lt;a href="#-brandschutzma%c3%9fnahmen" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Feuerfeste Unterlage:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Platzieren Sie den Controller auf einer &lt;strong&gt;nicht brennbaren Unterlage&lt;/strong&gt; (z. B. Metall, Keramik).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Rauchmelder:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Installieren Sie einen &lt;strong&gt;Rauchmelder&lt;/strong&gt; in der Nähe des Controllers.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Notfall-Abschaltung:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Stecker in Reichweite&lt;/strong&gt; halten, um den Controller im Notfall schnell vom Strom zu trennen.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;hr&gt;
&lt;h2&gt;⚡ &lt;strong&gt;Blitzschutz &amp;amp; Überspannungsschutz&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-blitzschutz--überspannungsschutz"&gt;&lt;/span&gt;
&lt;a href="#-blitzschutz--%c3%bcberspannungsschutz" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h2&gt;&lt;h3&gt;&lt;strong&gt;🔹 Überspannungsschutz für 230V&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-überspannungsschutz-für-230v"&gt;&lt;/span&gt;
&lt;a href="#-%c3%bcberspannungsschutz-f%c3%bcr-230v" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Überspannungsableiter (SPD):&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Empfohlen für Outdoor-Anlagen&lt;/strong&gt; (z. B. Pool-Pumpen im Freien).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Typ 2 SPD&lt;/strong&gt; (für Haushaltsanwendungen).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Anschluss:&lt;/strong&gt; Zwischen &lt;strong&gt;L/N und PE&lt;/strong&gt; (vor dem RCD).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Netzfilter:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Reduziert Störungen&lt;/strong&gt; durch andere Geräte (z. B. Motorsteuerungen).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Empfohlen für empfindliche Elektronik&lt;/strong&gt; (z. B. ESP32).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;hr&gt;
&lt;h2&gt;🌧️ &lt;strong&gt;Outdoor-Einsatz &amp;amp; Witterungsschutz&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-outdoor-einsatz--witterungsschutz"&gt;&lt;/span&gt;
&lt;a href="#-outdoor-einsatz--witterungsschutz" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h2&gt;&lt;h3&gt;&lt;strong&gt;🔹 Schutz vor Feuchtigkeit&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-schutz-vor-feuchtigkeit"&gt;&lt;/span&gt;
&lt;a href="#-schutz-vor-feuchtigkeit" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Gehäuse:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Mindestens IP54&lt;/strong&gt; (staubgeschützt, spritzwassergeschützt).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Empfohlen: IP65 oder höher&lt;/strong&gt; für Outdoor-Einsatz.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Beispiele:&lt;/strong&gt;
&lt;ul&gt;
&lt;li&gt;&lt;a
href="https://www.hammfg.com/"target="_blank" rel="noopener"&gt;Hammond 1591XXSS&lt;/a&gt; (IP65, Kunststoff).&lt;/li&gt;
&lt;li&gt;&lt;a
href="https://www.bopla.de/"target="_blank" rel="noopener"&gt;Bopla 7130&lt;/a&gt; (IP65, Polycarbonat).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Kabeldurchführungen:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Kabelgarnituren (PG-Verschraubungen)&lt;/strong&gt; verwenden.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;IP68 für Unterwasser-Anwendungen&lt;/strong&gt; (z. B. für Sensoren im Pool).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Dichtungen:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Silicon-Dichtmasse&lt;/strong&gt; für Kabeldurchführungen.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Dichtungsringe&lt;/strong&gt; für Gehäuseverschlüsse.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;&lt;strong&gt;🔹 Schutz vor Hitze &amp;amp; Kälte&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-schutz-vor-hitze--kälte"&gt;&lt;/span&gt;
&lt;a href="#-schutz-vor-hitze--k%c3%a4lte" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Temperaturbereich:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;ESP32:&lt;/strong&gt; -40°C bis +85°C (aber &lt;strong&gt;nicht für direkte Sonneneinstrahlung&lt;/strong&gt; geeignet).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Relay-Modul:&lt;/strong&gt; -20°C bis +70°C.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;DS18B20:&lt;/strong&gt; -55°C bis +125°C.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Kühlung:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Belüftung&lt;/strong&gt; im Gehäuse sicherstellen.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Keine direkte Sonneneinstrahlung&lt;/strong&gt; (z. B. durch Schatten oder Abdeckung).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Heizung (für kalte Umgebungen):&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Nicht erforderlich&lt;/strong&gt; für normale Anwendungen (Pool-Temperatur &amp;gt; 0°C).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Für Extrembedingungen:&lt;/strong&gt; Verwenden Sie ein &lt;strong&gt;beheiztes Gehäuse&lt;/strong&gt;.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;hr&gt;
&lt;h2&gt;🏊 &lt;strong&gt;Sicherheit am Pool&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-sicherheit-am-pool"&gt;&lt;/span&gt;
&lt;a href="#-sicherheit-am-pool" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h2&gt;&lt;h3&gt;&lt;strong&gt;🔹 Allgemeine Pool-Sicherheit&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-allgemeine-pool-sicherheit"&gt;&lt;/span&gt;
&lt;a href="#-allgemeine-pool-sicherheit" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Elektrische Geräte am Pool:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Mindestens 3,5m Abstand&lt;/strong&gt; von der Poolkante (gemäß DIN VDE 0100-702).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Ausnahme:&lt;/strong&gt; Geräte mit &lt;strong&gt;IPX8-Schutz&lt;/strong&gt; (z. B. Unterwasser-Pumpen).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Pumpen &amp;amp; Filter:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Immer mit RCD (30mA) absichern!&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Regelmäßig auf Undichtigkeiten prüfen!&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Kabel &amp;amp; Stecker:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Keine Steckdosen in Reichweite des Pools!&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Verwenden Sie fest installierte Kabel&lt;/strong&gt; (keine Verlängerungskabel!).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;&lt;strong&gt;🔹 Sensoren im Pool&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-sensoren-im-pool"&gt;&lt;/span&gt;
&lt;a href="#-sensoren-im-pool" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;DS18B20-Sensoren:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Wasserdicht (IP68)&lt;/strong&gt; für Pool-Anwendungen.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Kabel mit PG-Verschraubung&lt;/strong&gt; ins Gehäuse führen.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Kabelverlegung:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Keine Kabel im Pool verlegen!&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Kabel in Rohren oder Kabelkanälen&lt;/strong&gt; verlegen.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;hr&gt;
&lt;h2&gt;📜 &lt;strong&gt;Rechtliche Hinweise &amp;amp; Haftungsausschluss&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-rechtliche-hinweise--haftungsausschluss"&gt;&lt;/span&gt;
&lt;a href="#-rechtliche-hinweise--haftungsausschluss" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h2&gt;&lt;h3&gt;&lt;strong&gt;🔹 Wichtig: Dieses Projekt ist NUR für den Eigenbau!&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-wichtig-dieses-projekt-ist-nur-für-den-eigenbau"&gt;&lt;/span&gt;
&lt;a href="#-wichtig-dieses-projekt-ist-nur-f%c3%bcr-den-eigenbau" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Keine CE-Kennzeichnung:&lt;/strong&gt; Dieses Projekt ist &lt;strong&gt;nicht für den Verkauf oder die kommerzielle Nutzung&lt;/strong&gt; bestimmt.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Keine Gewährleistung:&lt;/strong&gt; Der Autor übernimmt &lt;strong&gt;keinerlei Haftung&lt;/strong&gt; für Schäden, Verletzungen oder Tod durch falsche Handhabung.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Eigenverantwortung:&lt;/strong&gt; Der Aufbau und Betrieb dieses Projekts erfolgt &lt;strong&gt;auf eigene Gefahr&lt;/strong&gt;.&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;&lt;strong&gt;🔹 Empfehlung für Unsichere&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-empfehlung-für-unsichere"&gt;&lt;/span&gt;
&lt;a href="#-empfehlung-f%c3%bcr-unsichere" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h3&gt;&lt;p&gt;Falls Sie sich &lt;strong&gt;unsicher sind&lt;/strong&gt; oder &lt;strong&gt;keine Erfahrung mit 230V-Elektronik haben&lt;/strong&gt;, empfehlen wir:&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Konsultieren Sie einen Elektriker!&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Ein &lt;strong&gt;Fachmann&lt;/strong&gt; kann die Verdrahtung prüfen und sicherstellen, dass alles den &lt;strong&gt;VDE-Bestimmungen&lt;/strong&gt; entspricht.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Verwenden Sie fertige Lösungen:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Es gibt &lt;strong&gt;kommerzielle Pool-Steuerungen&lt;/strong&gt; (z. B. von &lt;strong&gt;Hayward, Pentair,
oder AstralPool&lt;/strong&gt;), die &lt;strong&gt;CE-zertifiziert&lt;/strong&gt; sind.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Bilden Sie sich weiter:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Kurse für Elektroinstallation&lt;/strong&gt; (z. B. bei der &lt;strong&gt;Handwerkskammer&lt;/strong&gt;).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Bücher über Elektrotechnik&lt;/strong&gt; (z. B. &amp;ldquo;Elektroinstallation für Dummies&amp;rdquo;).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;hr&gt;
&lt;h2&gt;📞 &lt;strong&gt;Notfallmaßnahmen&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-notfallmaßnahmen"&gt;&lt;/span&gt;
&lt;a href="#-notfallma%c3%9fnahmen" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h2&gt;&lt;h3&gt;&lt;strong&gt;🔹 Bei Stromschlag:&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-bei-stromschlag"&gt;&lt;/span&gt;
&lt;a href="#-bei-stromschlag" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Strom abschalten!&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;FI-Schalter (RCD) auslösen&lt;/strong&gt; oder &lt;strong&gt;Sicherung (MCB) herausdrehen&lt;/strong&gt;.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Erste Hilfe leisten:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Nicht den Verletzten anfassen!&lt;/strong&gt; (könnte selbst unter Spannung stehen).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Notruf absetzen:&lt;/strong&gt; &lt;strong&gt;112 (Europa)&lt;/strong&gt; oder &lt;strong&gt;lokale Notrufnummer&lt;/strong&gt;.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Erste-Hilfe-Maßnahmen&lt;/strong&gt; (falls kein Strom mehr anliegt).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;h3&gt;&lt;strong&gt;🔹 Bei Brand:&lt;/strong&gt;&lt;span class="hx:absolute hx:-mt-20" id="-bei-brand"&gt;&lt;/span&gt;
&lt;a href="#-bei-brand" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Strom abschalten!&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;FI-Schalter (RCD) auslösen&lt;/strong&gt; oder &lt;strong&gt;Hauptsicherung abschalten&lt;/strong&gt;.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Löschen:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;NICHT mit Wasser löschen!&lt;/strong&gt; (230V-Gefahr!).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Verwenden Sie einen CO₂- oder Pulverlöscher&lt;/strong&gt; (für Elektronikbrände).&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Notruf absetzen:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;112 (Europa)&lt;/strong&gt; oder &lt;strong&gt;lokale Notrufnummer&lt;/strong&gt;.&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;hr&gt;
