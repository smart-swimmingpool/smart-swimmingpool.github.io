&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;code&gt;diagnostic&lt;/code&gt;&lt;/td&gt;
&lt;td&gt;&lt;strong&gt;Diagnostics&lt;/strong&gt; section&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
