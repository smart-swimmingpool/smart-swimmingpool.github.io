&lt;tr&gt;
&lt;td&gt;Solar Panel (6V)&lt;/td&gt;
&lt;td&gt;Power source&lt;/td&gt;
&lt;td&gt;10-15 €&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;LiPo Battery (18650)&lt;/td&gt;
&lt;td&gt;Energy storage&lt;/td&gt;
&lt;td&gt;5-10 €&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Charging Circuit&lt;/td&gt;
&lt;td&gt;Battery management&lt;/td&gt;
&lt;td&gt;3-5 €&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Enclosure&lt;/td&gt;
&lt;td&gt;Weather protection&lt;/td&gt;
&lt;td&gt;5-10 €&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;strong&gt;Total&lt;/strong&gt;&lt;/td&gt;
&lt;td&gt;&lt;/td&gt;
